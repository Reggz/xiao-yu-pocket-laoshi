{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "includeFiles": "docs/**"
    }
  },
  "crons": [
    {
      "path": "/api/scheduler",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/scheduler",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/scheduler",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/keepalive",
      "schedule": "0 1 * * 1,4"
    },
    {
      "path": "/api/retention",
      "schedule": "30 2 * * 1"
    }
  ]
}
