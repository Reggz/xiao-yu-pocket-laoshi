{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "includeFiles": "docs/**"
    }
  },
  "crons": [
    {
      "path": "/api/scheduler",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/scheduler",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/scheduler",
      "schedule": "30 21 * * *"
    }
  ]
}
